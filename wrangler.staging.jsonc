{
  "name": "rise-jev-preview",
  "main": "./worker/index.mjs",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // The Kev worker script carries its own policy (worker/kev-worker-script.mjs).
    "run_worker_first": ["/api/*", "/assets/kev-worker-*", "/assets/embed-worker-*"]
  }
}
