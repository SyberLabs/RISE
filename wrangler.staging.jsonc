{
  "name": "rise-jev-preview",
  "main": "./worker/index.mjs",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // The Kev worker script carries its own policy (worker/enterprise-decision.mjs).
    "run_worker_first": ["/api/*", "/assets/kev-worker-*"]
  },
  "secrets": {
    "required": [
      "OPENROUTER_API_KEY",
      "NEON_DATABASE_URL",
      "UPSTASH_REDIS_REST_URL",
      "UPSTASH_REDIS_REST_TOKEN"
    ]
  },
  "ratelimits": [{
    "name": "DECISION_LIMITER",
    "namespace_id": "2026092601",
    "simple": { "limit": 30, "period": 60 }
  }, {
    "name": "VISUAL_SCORE_LIMITER",
    "namespace_id": "2026092702",
    "simple": { "limit": 6, "period": 60 }
  }]
}
