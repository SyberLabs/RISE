{
  "name": "rise",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "RISE - a browser-based audiovisual reader for text, procedural form, art, sound, and temporal composition",
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run content:build && vite build",
    "audio:hydrate": "node scripts/hydrate-recitation.mjs",
    "build:fonts": "node scripts/build-fonts.mjs",
    "verify:fonts": "node scripts/build-fonts.mjs --check",
    "build:legal": "node scripts/build-legal.mjs",
    "verify:legal": "node scripts/build-legal.mjs --check",
    "preview": "vite preview",
    "local": "node local/rise-local.mjs",
    "test": "npm run content:build && vitest",
    "test:run": "npm run content:build && vitest run",
    "test:e2e": "playwright test",
    "measure:first-load": "node scripts/measure-first-load.mjs",
    "security:audit": "npm audit --audit-level=high",
    "security:compat": "node scripts/verify-security-dependencies.mjs",
    "docs:diagram": "node scripts/build-architecture-diagram.mjs",
    "render:mp4": "node scripts/render-mp4.mjs",
    "render:mill": "node scripts/render-mill.mjs",
    "content:build": "vite-node scripts/build-content-plane.mjs",
    "test:e2e:gate": "playwright test --project=gate",
    "wiki:build": "node scripts/build-wiki.mjs",
    "roadmap:check": "node scripts/roadmap.mjs validate",
    "roadmap:dev": "node scripts/roadmap.mjs serve",
    "roadmap:build": "node scripts/roadmap.mjs build",
    "test:roadmap": "node --test scripts/roadmap.test.mjs tools/roadmap/dashboard.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.0.0",
    "vite": "^7.3.7",
    "vite-node": "^3.2.4",
    "vitest": "^4.1.12",
    "wrangler": "4.144.0"
  },
  "dependencies": {
    "@ai-ecoverse/kev.js": "1.0.0",
    "@huggingface/tokenizers": "0.2.0",
    "acorn": "^8.19.0",
    "katex": "^0.19.0",
    "onnxruntime-web": "1.30.0",
    "speech-rule-engine": "4.1.4",
    "sql.js": "^1.14.2"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12",
    "sharp": "0.35.5",
    "undici": "7.30.1"
  }
}
