  "version": "1.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "RISE - a browser-based audiovisual reader for text, procedural form, art, sound, and temporal composition",
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
