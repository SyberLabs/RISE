/*
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(self), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://www.artic.edu https://images.metmuseum.org https://openaccess-cdn.clevelandart.org https://iiif.micr.io https://cdm16998.contentdm.oclc.org https://quod.lib.umich.edu https://cdn.esahubble.org https://esahubble.org https://images-assets.nasa.gov https://cdn.eso.org https://www.eso.org https://upload.wikimedia.org https://media.artmuseum.princeton.edu; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' https://syberlabs.io https://www.gutenberg.org https://export.arxiv.org https://commons.wikimedia.org https://upload.wikimedia.org https://api.artic.edu https://www.artic.edu https://collectionapi.metmuseum.org https://openaccess-api.clevelandart.org https://id.rijksmuseum.nl https://openrouter.ai https://generativelanguage.googleapis.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/connect/*
  Referrer-Policy: no-referrer
  Cache-Control: no-store

# The Plus success page carries a Checkout session id in its query: never sent on, never kept.
/plus/claim
  Referrer-Policy: no-referrer
  Cache-Control: no-store

/site.webmanifest
  Content-Type: application/manifest+json

# Linked source documents are readable text, including the extensionless ones.
/LICENSE
  Content-Type: text/plain; charset=utf-8

/NOTICE
  Content-Type: text/plain; charset=utf-8

/ASSET-LICENSES.md
  Content-Type: text/plain; charset=utf-8

/PRIVACY.md
  Content-Type: text/plain; charset=utf-8

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/audio/recitation/*
  Cache-Control: public, max-age=31536000, immutable

/content/works/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/json

/content/manifest.json
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/json




/content/catalog.json
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/json
