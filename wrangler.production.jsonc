{
  "name": "rise-production",
  "main": "./worker/index.mjs",
  "compatibility_date": "2026-09-26",
  "workers_dev": false,
  "preview_urls": false,
  // This Worker runs no model and holds no model credential. Readers connect
  // their own OpenRouter account or run Kev locally (docs/USER-OWNED-AI.md).
  // rise.syberlabs.io is attached to this Worker in the Cloudflare dashboard.
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // The Kev worker script carries its own policy (worker/kev-worker-script.mjs).
    "run_worker_first": ["/api/*", "/assets/kev-worker-*"]
  },
  // Only the public decision catalog reads these. Model credentials such as
  // OPENROUTER_API_KEY are no longer required; delete them only after this
  // release is verified serving 410 on every retired route (docs/USER-OWNED-AI.md).
  "secrets": {
    "required": [
      "NEON_DATABASE_URL",
      "UPSTASH_REDIS_REST_URL",
      "UPSTASH_REDIS_REST_TOKEN"
    ]
  },
  "ratelimits": [{
    "name": "DECISION_LIMITER",
    "namespace_id": "2026092602",
    "simple": { "limit": 30, "period": 60 }
  }]
}
