{
  "name": "rise-production",
  "main": "./worker/index.mjs",
  "services": [{ "binding": "PLUS_VOICE_PROVIDER", "service": "rise-plus-preview", "entrypoint": "VoiceProvider" }],
  "compatibility_date": "2026-09-26",
  "workers_dev": false,
  "preview_urls": false,
  // Shared model inference is retired. Readers use their own OpenRouter account
  // or run Kev locally; the optional live integrations remain switched off.
  "vars": { "LIVE_REALTIME_ENABLED": "false", "MCP_ENABLED": "true", "MCP_SELF_CONTAINED": "true", "PLUS_VOICE_MODEL": "eleven_flash_v2_5", "PLUS_PAYMENT_LINK": "https://buy.stripe.com/test_aFa7sL5HpfHD0K5bIP9MY00",
    "PLUS_DAILY_CHAR_CAP": "500000",
    // Cost ceilings are based on paid USD invoice revenue, not the advertised price.
    "PLUS_VENDOR_MICRO_USD_PER_CHAR": "60",
    "PLUS_FEE_BPS": "500",
    "PLUS_FEE_FIXED_USD_CENTS": "50",
    "PLUS_RESERVE_BPS": "5000",
    // All administrators share this monthly budget and daily character cap.
    "PLUS_ADMIN_MONTHLY_USD_CENTS": "500",
    "PLUS_ADMIN_DAILY_CHAR_CAP": "25000",
    // Dedicated Access audience remains unset until its admin-only application is configured.
    "PLUS_ADMIN_ACCESS_ISSUER": "https://sweet-base-63a2.cloudflareaccess.com",
    // Production takes real money: Plus answers 503 and serves no payment link unless the Stripe key and
    // PLUS_PAYMENT_LINK are live and STRIPE_WEBHOOK_SECRET is set (worker/plus.mjs). Never set in the preview.
    "PLUS_REQUIRE_LIVE": "true",
    // The voices a reader may choose (worker/plus.mjs). ElevenLabs premade voice ids, not secret;
    // "default" takes its id from the PLUS_VOICE_ID secret. GET /api/plus/voices lists slugs and labels only.
    "PLUS_VOICES": [{ "slug": "default", "label": "Default" }, { "slug": "george", "label": "George — warm British narrator", "id": "JBFqnCBsd6RMkjVDRZzb" }, { "slug": "rachel", "label": "Rachel — calm American", "id": "21m00Tcm4TlvDq8ikWAM" }, { "slug": "daniel", "label": "Daniel — deep British", "id": "onwK4e9ZLuTAKqWW03F9" }, { "slug": "charlotte", "label": "Charlotte — soft, measured", "id": "XB0fDUnXU5powFXDhCwa" }] },
  // rise.syberlabs.io is attached to this Worker in the Cloudflare dashboard.
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // The Kev worker script carries its own policy (worker/kev-worker-script.mjs).
    // /live reaches handleLive (worker/mcp-server.mjs), which loosens the embedded page's framing
    // headers only while MCP_ENABLED is "true"; off, the page is served exactly as the asset.
    // /content/arena/* reaches serveArenaFile, so a missing run file is a 404, not the app shell.
    "run_worker_first": ["/api/*", "/live", "/assets/kev-worker-*", "/assets/embed-worker-*", "/content/arena/*"]
  },
  // Serves the live Realtime route (worker/live-realtime.mjs); off by default.
  // The paid voice (worker/plus.mjs). It stores no audio and no reader text, so there is no bucket.
  // Secrets STRIPE_SECRET_KEY and PLUS_COOKIE_SECRET switch the routes on; without them they answer 503.
  // Also set as secrets (a dashboard var is dropped by the next deploy): PLUS_PRICE_ID, the live
  // Stripe price of RISE Plus (unset, every claim and voicing is refused), and PLUS_VOICE_ID, the
  // ElevenLabs voice; ELEVENLABS_API_KEY for the voice route. PLUS_COOKIE_SECRET here must differ
  // from rise-plus-preview's: a cookie signed by the preview must never verify on production.
  // PLUS_DAILY_CHAR_CAP (vars) is the characters every subscriber together may voice per UTC day
  // (500,000 is budgeted at $30 using the conservative cost rate); unset or not a positive number, the voice answers 503.
  // STRIPE_WEBHOOK_SECRET (secret) is the signing secret of the Stripe webhook endpoint at
  // /api/plus/stripe-webhook (events and setup: worker/plus.mjs); unset, that route answers 503.
  // PLUS_PAYMENT_LINK (vars) is the Stripe Payment Link the Subscribe button opens: still the
  // test-mode link, which PLUS_REQUIRE_LIVE refuses to serve; going live is this value and the live
  // secrets, not a code change. PLUS_SUB_DAILY_CHAR_CAP (vars, unset: 25,000) caps one subscription a day.
  // PLUS_METER holds each subscription's allowance and the daily total (SQLite-backed, free plan).
  "durable_objects": { "bindings": [{ "name": "PLUS_METER", "class_name": "PlusMeter" }] },
  "migrations": [{ "tag": "plus-meter-v1", "new_sqlite_classes": ["PlusMeter"] }],
  "ratelimits": [{
    "name": "DECISION_LIMITER",
    "namespace_id": "2026092602",
    "simple": { "limit": 30, "period": 60 }
  }, {
    // POST /api/plus/claim needs no cookie and costs a Stripe call, so each address gets 5 a minute.
    "name": "PLUS_CLAIM_LIMITER",
    "namespace_id": "2026100802",
    "simple": { "limit": 5, "period": 60 }
  }]
}
