{
  "name": "rise-production",
  "main": "./worker/index.mjs",
  "compatibility_date": "2026-09-26",
  "workers_dev": false,
  "preview_urls": false,
  // Shared model inference is retired. Readers use their own OpenRouter account
  // or run Kev locally; the optional live integrations remain switched off.
  "vars": { "PERSONAL_PIECE_ENABLED": "false", "LIVE_REALTIME_ENABLED": "false", "MCP_ENABLED": "false" },
  // rise.syberlabs.io is attached to this Worker in the Cloudflare dashboard.
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // The Kev worker script carries its own policy (worker/kev-worker-script.mjs).
    "run_worker_first": ["/api/*", "/assets/kev-worker-*"]
  },
  // Only the public catalog reads these. Provider credentials are not required.
  "secrets": {
    "required": [
      "NEON_DATABASE_URL",
      "UPSTASH_REDIS_REST_URL",
      "UPSTASH_REDIS_REST_TOKEN"
    ]
  },
  "ratelimits": [{
    "name": "DECISION_LIMITER",
    "namespace_id": "2026092602",
    "simple": { "limit": 30, "period": 60 }
  }]
}
